---
import { t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const sobre = t(lang).sobre;
// Dividir el título en dos líneas coherentes (corte en la coma).
const _tp = sobre.titulo.split(/,\s+/);
const tituloL1 = _tp.length > 1 ? _tp[0] + ',' : sobre.titulo;
const tituloL2 = _tp.length > 1 ? _tp.slice(1).join(', ') : '';
---

<section id="sobre" class="pt-24 pb-16 md:pt-32 md:pb-20">
  <div class="shell" style="--max: 82rem;">
    <!-- Título centrado, en dos líneas coherentes -->
    <h2 class="reveal mx-auto max-w-4xl text-center font-display text-h-md font-semibold text-porcelain">
      {tituloL1}{tituloL2 && <br />}{tituloL2}
    </h2>

    <div class="mt-12 grid gap-12 md:mt-14 md:grid-cols-12 md:items-start md:gap-10">
      <!-- Izquierda: la foto con tilt 3D al mover el cursor -->
      <div class="md:col-span-5">
        <div class="reveal max-w-[350px] [perspective:1100px] md:ml-[60px]">
          <div
            data-tilt
            class="relative w-full will-change-transform [transform-style:preserve-3d]"
            style="transition: transform 0.18s ease-out;"
          >
            <img
              src="/img/sobre.webp"
              alt="Siulverse — o design no comando"
              width="500"
              height="889"
              class="block h-auto w-full opacity-0 transition-opacity duration-500 data-[loaded]:opacity-100"
              loading="lazy"
              onload="this.setAttribute('data-loaded','')"
            />
            <!-- Brillo que sigue el cursor -->
            <span
              data-tilt-glare
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 opacity-0"
              style="transition: opacity 0.2s ease-out; mix-blend-mode: overlay;"
            ></span>
          </div>
        </div>
      </div>

      <!-- Derecha: puntos + stats (la foto a la izquierda queda a su nivel) -->
      <div class="md:col-span-6 md:col-start-7">
        <dl class="divide-y divide-hairline">
          {
            sobre.pontos.map((p, i) => (
              <div class={`reveal ${i === 0 ? 'pb-7' : 'py-7'}`}>
                <dt class="font-display text-h-sm font-medium leading-none text-ember">{p.sinal}</dt>
                <dd class="mt-3 max-w-prose text-body text-greige">{p.texto}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 grid grid-cols-2 gap-8">
          {
            sobre.stats.map((s) => (
              <div class="reveal">
                <p class="font-display text-h-md font-semibold text-porcelain tabular-nums">{s.valor}</p>
                <p class="mt-1 text-label text-greige">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Efecto tilt 3D: la imagen se inclina hacia el cursor (sin clic/flip).
  function initTilt() {
    document.querySelectorAll('[data-tilt]').forEach((el) => {
      if (el.dataset.tiltInit) return;
      el.dataset.tiltInit = '1';
      const glare = el.querySelector('[data-tilt-glare]');
      const MAX = 13; // grados máximos de inclinación
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width; // 0..1
        const py = (e.clientY - r.top) / r.height; // 0..1
        const ry = (px - 0.5) * (MAX * 2);
        const rx = -(py - 0.5) * (MAX * 2);
        el.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg) scale(1.04)`;
        if (glare) {
          glare.style.opacity = '1';
          glare.style.background = `radial-gradient(circle at ${px * 100}% ${py * 100}%, rgba(255,255,255,0.45), rgba(255,255,255,0) 55%)`;
        }
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';
        if (glare) glare.style.opacity = '0';
      });
    });
  }
  initTilt();
  document.addEventListener('astro:page-load', initTilt);
</script>
