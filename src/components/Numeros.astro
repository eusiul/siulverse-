---
import { shared, t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const c = t(lang);
const ui = c.ui;
const items = shared.numerosValores.map((valor, i) => ({ valor, label: c.numerosLabels[i] }));
---

<section class="py-24 md:py-32" aria-label={ui.numerosTitle}>
  <div class="shell" style="--max: 82rem;">
    <h2 class="font-display text-h-sm font-medium text-greige">{ui.numerosTitle}</h2>
    <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-4">
      {
        items.map((n) => (
          <div class="reveal">
            <dt class="sr-only">{n.label}</dt>
            <dd>
              <span class="block font-display text-[clamp(3rem,2rem+6vw,6rem)] font-semibold leading-none text-porcelain tabular-nums">{n.valor}</span>
              <span class="mt-3 block text-label text-greige">{n.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
