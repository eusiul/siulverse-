---
import { shared, t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const ui = t(lang).ui;
const row = [...shared.clientes, ...shared.clientes];
---

<section class="border-y border-hairline py-10" aria-label={ui.clientesAria}>
  <div class="marquee">
    <ul class="marquee__track">
      {
        row.map((cl, i) => (
          <li class="marquee__item" aria-hidden={i >= shared.clientes.length ? 'true' : 'false'}>
            <img
              src={cl.img}
              alt={i >= shared.clientes.length ? '' : cl.nome}
              loading="lazy"
              class="h-7 w-auto opacity-90 transition-opacity duration-300 hover:opacity-100 md:h-9"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-inline: clamp(1.25rem, 3vw, 3rem);
    animation: marquee 32s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__item {
    flex: none;
    white-space: nowrap;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
