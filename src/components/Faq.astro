---
import { shared, t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const c = t(lang);
const ui = c.ui;
const faq = c.faq;
---

<section id="faq" class="py-24 md:py-32">
  <div class="shell" style="--max: 82rem;">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4">
        <h2 class="font-display text-h-md font-semibold text-porcelain">{ui.faqTitle}</h2>
        <button id="showreel-btn" class="btn-ghost mt-8" aria-haspopup="dialog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
          {ui.verShowreel}
        </button>
      </div>

      <div class="md:col-span-8">
        <div class="divide-y divide-hairline border-y border-hairline">
          {
            faq.map((item) => (
              <details class="group py-2">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-h-sm font-display font-medium text-porcelain [&::-webkit-details-marker]:hidden">
                  {item.q}
                  <span class="relative h-5 w-5 shrink-0 text-ember" aria-hidden="true">
                    <span class="absolute left-1/2 top-1/2 h-0.5 w-5 -translate-x-1/2 -translate-y-1/2 bg-current" />
                    <span class="absolute left-1/2 top-1/2 h-5 w-0.5 -translate-x-1/2 -translate-y-1/2 bg-current transition-transform duration-300 group-open:rotate-90 group-open:scale-0" />
                  </span>
                </summary>
                <p class="max-w-prose pb-6 text-body text-greige">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<dialog id="showreel-modal" class="w-[min(92vw,960px)] bg-onyx p-0 text-porcelain backdrop:bg-onyx/80">
  <div class="flex items-center justify-between border-b border-hairline px-5 py-3">
    <span class="text-label text-greige">{ui.showreelLabel}</span>
    <button id="showreel-close" class="text-greige hover:text-porcelain" aria-label={ui.fechar}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
    </button>
  </div>
  <div class="aspect-video w-full bg-surface" id="showreel-body" data-embed={shared.showreel.embed}>
    {!shared.showreel.embed && <div class="flex h-full items-center justify-center px-6 text-center text-label text-greige">{ui.showreelPh}</div>}
  </div>
</dialog>

<script>
  const modal = document.getElementById('showreel-modal');
  const openBtn = document.getElementById('showreel-btn');
  const closeBtn = document.getElementById('showreel-close');
  const body = document.getElementById('showreel-body');
  const embed = body?.dataset.embed;
  const open = () => {
    if (embed && !body.querySelector('iframe')) {
      const f = document.createElement('iframe');
      f.src = embed;
      f.title = 'Showreel';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      f.className = 'h-full w-full';
      body.innerHTML = '';
      body.appendChild(f);
    }
    modal?.showModal();
  };
  const close = () => {
    modal?.close();
    const f = body?.querySelector('iframe');
    if (f) f.src = embed;
  };
  openBtn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
</script>
