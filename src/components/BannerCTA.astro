---
import { shared, t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const c = t(lang);
const ui = c.ui;
const waHref = `https://wa.me/${shared.whatsapp}?text=${encodeURIComponent(c.whatsappMsg)}`;
---

<section class="bg-porcelain py-24 text-onyx md:py-32">
  <div class="shell" style="--max: 82rem;">
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <h2 class="font-display text-h-lg font-semibold md:col-span-8">
        {ui.bannerL1}<br />{ui.bannerL2}
      </h2>
      <div class="md:col-span-4 md:text-right">
        <a href={waHref} target="_blank" rel="noopener" class="btn bg-ember text-porcelain transition-transform duration-300 ease-emph hover:-translate-y-0.5">
          {ui.bannerCta}
        </a>
      </div>
    </div>
  </div>
</section>
