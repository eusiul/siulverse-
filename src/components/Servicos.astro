---
import { t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const c = t(lang);
const ui = c.ui;
---

<section id="servicos" class="py-24 md:py-32">
  <div class="shell" style="--max: 82rem;">
    <h2 class="font-display text-h-md font-semibold text-porcelain">{ui.servicosTitle}</h2>

    <ul class="mt-14 flex flex-col">
      {
        c.servicos.map((s) => (
          <li class={`reveal group border-t border-hairline py-8 transition-colors duration-300 last:border-b md:py-10 ${s.destaque ? 'bg-surface/40' : 'hover:bg-surface/40'}`}>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:items-baseline md:gap-8">
              <span class="index-num md:col-span-1">{s.num}</span>
              <div class="md:col-span-4">
                <h3 class={`font-display text-h-sm font-medium ${s.destaque ? 'text-ember' : 'text-porcelain'}`}>{s.nome}</h3>
                <span class="mt-1 inline-block text-mono uppercase text-greige">{s.tag}</span>
              </div>
              <p class="text-body text-greige md:col-span-7">
                {s.texto}
                {s.destaque && <span class="mt-2 block text-label text-bronze">{ui.diferencialLabel}</span>}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
