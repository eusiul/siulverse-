---
import { shared, t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const c = t(lang);
const ui = c.ui;
const waPlan = (nome) => `https://wa.me/${shared.whatsapp}?text=${encodeURIComponent(`${ui.planWaMsg} ${nome}.`)}`;
const waPersonaliza = `https://wa.me/${shared.whatsapp}?text=${encodeURIComponent(ui.personalizaWaMsg)}`;
const waQuote = `https://wa.me/${shared.whatsapp}?text=${encodeURIComponent(ui.cotizarMsg)}`;
---

<section id="planos" class="py-24 md:py-32">
  <div class="shell" style="--max: 82rem;">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-h-md font-semibold text-porcelain">{ui.planosTitle}</h2>
      <p class="mt-4 text-body-lg text-greige">{ui.planosSub}</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-sm grid-cols-1 gap-5 lg:max-w-4xl lg:grid-cols-3">
      {
        c.planos.map((p) => (
          <div class={`reveal relative h-full ${p.destaque ? 'group overflow-hidden p-[2px] shadow-xl transition-shadow duration-500 hover:shadow-[0_0_38px_-10px_rgba(255,0,0,0.55)] lg:-mt-3 lg:mb-3' : ''}`}>
            {p.destaque && (
              <>
                {/* Borde rojo sólido (por defecto) */}
                <span class="pointer-events-none absolute inset-0 bg-ember transition-opacity duration-500 group-hover:opacity-0" aria-hidden="true" />
                {/* Gradiente cónico rojo girando (al pasar el cursor) */}
                <span
                  class="pointer-events-none absolute inset-[-1000%] animate-[border-spin_1.4s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#FF0000_0%,#ff6b6b_25%,#7a0000_50%,#ff2d2d_75%,#FF0000_100%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                  aria-hidden="true"
                />
              </>
            )}
          <article class={`relative flex h-full flex-col p-6 ${p.destaque ? 'bg-surface-2' : 'bg-surface'}`}>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-display text-body-lg font-semibold text-porcelain">{p.nome}</h3>
              {p.selo && <span class="shrink-0 bg-ember px-2 py-0.5 text-mono uppercase text-porcelain">{p.selo}</span>}
            </div>
            <p class="mt-1.5 text-label text-greige">{p.para}</p>

            <p class="mt-4 font-display text-h-sm font-semibold text-porcelain">
              {p.preco}
              <span class="text-label align-baseline font-sans font-normal text-greige">{ui.periodo}</span>
            </p>

            <ul class="mt-4 flex flex-1 flex-col gap-2.5">
              {p.itens.map((it) => (
                <li class="flex gap-2.5 text-label text-greige">
                  <span class="mt-1.5 h-1 w-1 shrink-0 bg-ember" aria-hidden="true" />
                  <span>{it}</span>
                </li>
              ))}
            </ul>

            <a href={waPlan(p.nome)} target="_blank" rel="noopener" class={`mt-6 ${p.destaque ? 'btn-primary' : 'btn-ghost'} w-full !py-2.5 text-label`}>
              {p.cta}
            </a>
          </article>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-8 flex max-w-xl items-center justify-center gap-2.5 border border-ember/40 bg-ember/5 px-5 py-3 text-center">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-ember">
        <path d="M12 3l7 3v5c0 4.2-2.8 7.5-7 9-4.2-1.5-7-4.8-7-9V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <p class="text-label font-medium text-porcelain">{ui.garantia}</p>
    </div>
    <p class="mx-auto mt-4 flex max-w-2xl items-center justify-center gap-2 text-center text-label text-porcelain">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0 text-ember"><path d="M12 2l2.9 6.3L22 9l-5 4.6L18.2 21 12 17.3 5.8 21 7 13.6 2 9l7.1-.7L12 2z"/></svg>
      {ui.bonus}
    </p>
    <p class="mx-auto mt-2 max-w-4xl text-center text-label text-greige">{ui.cancelNote}</p>

    <!-- Personaliza tu plan (discreto) -->
    <div class="mx-auto mt-8 flex max-w-xl flex-col items-center gap-3 text-center sm:flex-row sm:justify-center sm:gap-4">
      <p class="text-label text-greige">{ui.personalizaText}</p>
      <a href={waPersonaliza} target="_blank" rel="noopener" class="btn-ghost shrink-0 !py-2 !px-4 text-label">{ui.personalizaCta}</a>
    </div>

    <div class="mt-20 border-t border-hairline pt-14">
      <div class="grid gap-10 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-4">
          <h3 class="font-display text-h-sm font-semibold text-porcelain">{ui.avulsosTitle}</h3>
          <p class="mt-3 max-w-prose text-body text-greige">{c.avulsos.nota}</p>
          <a href={waQuote} target="_blank" rel="noopener" class="btn-primary mt-6">{ui.cotizarCta}</a>
        </div>

        <div class="grid gap-10 md:col-span-8 md:grid-cols-2">
          {
            c.avulsos.grupos.map((g) => (
              <div class="reveal">
                <h4 class="text-label uppercase tracking-wide text-bronze">{g.nome}</h4>
                <ul class="mt-4 divide-y divide-hairline">
                  {g.itens.map((it) => (
                    <li class="py-3 text-body text-porcelain">{it}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
