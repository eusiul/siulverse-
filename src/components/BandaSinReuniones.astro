---
import { t } from '../i18n/content.js';
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const ui = t(lang).ui;
---

<section class="border-y border-hairline bg-surface">
  <div class="shell grid gap-6 py-12 md:grid-cols-12 md:items-center md:py-14" style="--max: 82rem;">
    <div class="md:col-span-5">
      <span class="inline-flex items-center gap-2 text-mono uppercase tracking-wide text-ember">
        <span class="h-1.5 w-1.5 bg-ember" aria-hidden="true"></span>{ui.noMeetKicker}
      </span>
      <h2 class="mt-3 font-display text-h-sm font-semibold leading-tight text-porcelain">{ui.noMeetT}</h2>
    </div>
    <p class="text-body text-greige md:col-span-6 md:col-start-7">{ui.noMeetD}</p>
  </div>
</section>
