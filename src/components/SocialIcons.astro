---
import { shared } from '../i18n/content.js';
interface Props {
  class?: string;
}
const { class: klass = '' } = Astro.props;
const { social } = shared;
---

<ul class={`flex items-center gap-3 ${klass}`}>
  {
    social.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          aria-label={s.rede}
          class="flex h-10 w-10 items-center justify-center border border-porcelain/20 text-greige transition-colors duration-300 hover:border-porcelain/60 hover:text-porcelain"
        >
          {s.icon === 'instagram' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" />
            </svg>
          )}
          {s.icon === 'x' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.53 3h3.2l-7 8 8.23 10.99h-6.44l-5.05-6.6-5.77 6.6H.5l7.49-8.57L0 3h6.6l4.56 6.03L17.53 3Zm-1.12 16.09h1.77L6.68 4.81H4.78L16.41 19.09Z" />
            </svg>
          )}
          {s.icon === 'behance' && (
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8.2 10.1c.65-.33 1-.88 1-1.68 0-1.58-1.18-1.96-2.54-1.96H2v9.06h4.78c1.44 0 2.8-.7 2.8-2.31 0-1-.47-1.74-1.38-2.11ZM4 8.12h2.03c.78 0 1.48.22 1.48 1.12 0 .84-.55 1.18-1.33 1.18H4V8.12Zm2.2 5.77H4v-2.35h2.25c.95 0 1.55.4 1.55 1.2 0 .82-.71 1.15-1.6 1.15ZM21.4 8.45h-4.5V7.3h4.5v1.15Zm.6 4.14c0-1.94-1.14-3.56-3.2-3.56-2 0-3.36 1.5-3.36 3.47 0 2.04 1.29 3.44 3.36 3.44 1.57 0 2.58-.7 3.07-2.2h-1.76c-.17.56-.6.84-1.25.84-.9 0-1.37-.53-1.42-1.4H22c0-.2.01-.39.01-.59Zm-4.5-.43c.11-.77.56-1.25 1.33-1.25.78 0 1.18.52 1.23 1.25h-2.56Z" />
            </svg>
          )}
          {s.icon === 'linkedin' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.94 5.5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.4h3.1V21H3.4V8.4Zm5.06 0h2.97v1.72h.04c.41-.78 1.42-1.6 2.93-1.6 3.13 0 3.71 2.06 3.71 4.74V21h-3.1v-5.6c0-1.34-.02-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21h-3.1V8.4Z" />
            </svg>
          )}
          {s.icon === 'facebook' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.54-1.5h1.64V3.6c-.28-.04-1.26-.12-2.4-.12-2.37 0-4 1.45-4 4.1v2.29H7.5V13h2.8v8h3.2Z" />
            </svg>
          )}
          {s.icon === 'youtube' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.9 4.8 12 4.8 12 4.8s-6.9 0-8.6.5A2.7 2.7 0 0 0 1.5 7.2 28.3 28.3 0 0 0 1 12a28.3 28.3 0 0 0 .5 4.8 2.7 2.7 0 0 0 1.9 1.9c1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9A28.3 28.3 0 0 0 23 12a28.3 28.3 0 0 0-.5-4.8ZM9.8 15.3V8.7l5.7 3.3-5.7 3.3Z" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>
